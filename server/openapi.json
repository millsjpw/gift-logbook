{
  "openapi": "3.0.3",
  "info": {
    "title": "Gift Logbook API",
    "version": "3.0.0",
    "description": "OpenAPI v3 specification for the Gift Logbook service."
  },
  "servers": [
    {
      "url": "http://localhost:{port}",
      "description": "Local dev",
      "variables": {
        "port": {
          "default": "3000"
        }
      }
    }
  ],
  "components": {
    "securitySchemes": {
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "session"
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        },
        "required": ["id", "name", "email", "createdAt", "updatedAt"]
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string" }
        },
        "required": ["email", "password"]
      },
      "LoginResponse": {
        "type": "object",
        "description": "Authenticated user. A session cookie is set in the response.",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        },
        "required": ["id", "name", "email", "createdAt", "updatedAt"]
      },
      "Tag": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "userId": { "type": "string", "format": "uuid" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        },
        "required": ["id", "name", "userId", "createdAt", "updatedAt"]
      },
      "Person": {
        "type": "object",
        "description": "A person with their associated tags.",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "userId": { "type": "string", "format": "uuid" },
          "birthMonth": {
            "type": ["integer", "null"],
            "minimum": 1,
            "maximum": 12
          },
          "birthDay": {
            "type": ["integer", "null"],
            "minimum": 1,
            "maximum": 31
          },
          "birthYear": { "type": ["integer", "null"], "minimum": 1900 },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" },
          "tags": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Tag" }
          }
        },
        "required": ["id", "name", "userId", "createdAt", "updatedAt", "tags"]
      },
      "ListItem": {
        "type": "object",
        "description": "An item on a wish list, with its associated tags.",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "title": { "type": "string" },
          "url": { "type": ["string", "null"], "format": "uri" },
          "listId": { "type": "string", "format": "uuid" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" },
          "tags": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Tag" }
          }
        },
        "required": ["id", "title", "listId", "createdAt", "updatedAt", "tags"]
      },
      "List": {
        "type": "object",
        "description": "A wish list with its items.",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "userId": { "type": "string", "format": "uuid" },
          "personId": { "type": ["string", "null"], "format": "uuid" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" },
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ListItem" }
          }
        },
        "required": ["id", "name", "userId", "createdAt", "updatedAt", "items"]
      },
      "GiftRecord": {
        "type": "object",
        "description": "A logged gift record with its associated tags.",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "userId": { "type": "string", "format": "uuid" },
          "personId": { "type": ["string", "null"], "format": "uuid" },
          "itemText": { "type": "string" },
          "amount": {
            "type": ["string", "null"],
            "description": "Decimal amount as string (e.g. \"25.00\"), or null."
          },
          "date": { "type": "string", "format": "date-time" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" },
          "tags": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Tag" }
          }
        },
        "required": [
          "id",
          "userId",
          "itemText",
          "date",
          "createdAt",
          "updatedAt",
          "tags"
        ]
      },
      "Assignment": {
        "type": "object",
        "properties": {
          "giverId": { "type": "string", "format": "uuid" },
          "receiverId": { "type": "string", "format": "uuid" }
        },
        "required": ["giverId", "receiverId"]
      },
      "FullExchange": {
        "type": "object",
        "properties": {
          "exchange": { "type": "object" },
          "participants": { "type": "array", "items": { "type": "object" } },
          "assignments": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Assignment" }
          },
          "exclusions": { "type": "array", "items": { "type": "object" } }
        }
      }
    }
  },
  "security": [{ "cookieAuth": [] }],
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check",
        "security": [],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "Login",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful login",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LoginResponse" }
              }
            }
          },
          "401": { "description": "Invalid credentials" }
        }
      }
    },
    "/auth/me": {
      "get": {
        "summary": "Get current user",
        "description": "Returns the authenticated user for the current session cookie.",
        "security": [{ "cookieAuth": [] }],
        "responses": {
          "200": {
            "description": "Authenticated user",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/User" }
              }
            }
          },
          "401": { "description": "Not authenticated" }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "summary": "Logout",
        "responses": { "204": { "description": "Session revoked" } }
      }
    },
    "/users": {
      "post": {
        "summary": "Create user",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "email": { "type": "string", "format": "email" },
                  "password": { "type": "string" }
                },
                "required": ["name", "email", "password"]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/User" }
              }
            }
          }
        }
      }
    },
    "/users/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": { "type": "string", "format": "uuid" }
        }
      ],
      "get": {
        "summary": "Get user by ID",
        "responses": {
          "200": {
            "description": "User",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/User" }
              }
            }
          },
          "404": { "description": "Not found" }
        }
      },
      "put": {
        "summary": "Update user",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "email": { "type": "string", "format": "email" },
                  "password": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated user",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/User" }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete user",
        "responses": { "204": { "description": "Deleted" } }
      }
    },
    "/persons": {
      "post": {
        "summary": "Create person",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "birthMonth": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 12
                  },
                  "birthDay": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 31
                  },
                  "birthYear": { "type": "integer", "minimum": 1900 },
                  "tags": { "type": "array", "items": { "type": "string" } }
                },
                "required": ["name"]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Person created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Person" }
              }
            }
          }
        }
      },
      "get": {
        "summary": "Get all persons for the authenticated user",
        "responses": {
          "200": {
            "description": "Persons",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Person" }
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete all persons created by the authenticated user",
        "responses": { "204": { "description": "All persons deleted" } }
      }
    },
    "/persons/search": {
      "get": {
        "summary": "Search persons by name",
        "parameters": [
          {
            "name": "name",
            "in": "query",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Matching persons",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Person" }
                }
              }
            }
          }
        }
      }
    },
    "/persons/upcoming-birthdays": {
      "get": {
        "summary": "Get persons with upcoming birthdays",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "minimum": 1, "default": 5 }
          },
          {
            "name": "daysAhead",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "minimum": 0, "default": 180 },
            "description": "How many days ahead to look."
          }
        ],
        "responses": {
          "200": {
            "description": "Persons with upcoming birthdays",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Person" }
                }
              }
            }
          }
        }
      }
    },
    "/persons/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": { "type": "string", "format": "uuid" }
        }
      ],
      "get": {
        "summary": "Get person by ID",
        "responses": {
          "200": {
            "description": "Person",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Person" }
              }
            }
          },
          "404": { "description": "Not found" }
        }
      },
      "put": {
        "summary": "Update person",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "birthMonth": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 12
                  },
                  "birthDay": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 31
                  },
                  "birthYear": { "type": "integer", "minimum": 1900 },
                  "tags": { "type": "array", "items": { "type": "string" } }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated person",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Person" }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete person",
        "responses": { "204": { "description": "Deleted" } }
      }
    },
    "/lists": {
      "post": {
        "summary": "Create list",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "personId": { "type": "string", "format": "uuid" },
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "title": { "type": "string" },
                        "url": { "type": "string", "format": "uri" },
                        "tags": {
                          "type": "array",
                          "items": { "type": "string" }
                        }
                      },
                      "required": ["title"]
                    }
                  }
                },
                "required": ["name"]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "List created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/List" }
              }
            }
          }
        }
      },
      "get": {
        "summary": "Get all lists for the authenticated user",
        "responses": {
          "200": {
            "description": "Lists",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/List" }
                }
              }
            }
          }
        }
      }
    },
    "/lists/search": {
      "get": {
        "summary": "Search lists by name",
        "parameters": [
          {
            "name": "name",
            "in": "query",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Matching lists",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/List" }
                }
              }
            }
          }
        }
      }
    },
    "/lists/recent": {
      "get": {
        "summary": "Get recently updated lists",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "minimum": 1, "default": 5 }
          }
        ],
        "responses": {
          "200": {
            "description": "Recent lists",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/List" }
                }
              }
            }
          }
        }
      }
    },
    "/lists/person/{personId}": {
      "get": {
        "summary": "Get lists by person",
        "parameters": [
          {
            "name": "personId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "Lists for the given person",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/List" }
                }
              }
            }
          }
        }
      }
    },
    "/lists/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": { "type": "string", "format": "uuid" }
        }
      ],
      "get": {
        "summary": "Get list by ID",
        "responses": {
          "200": {
            "description": "List",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/List" }
              }
            }
          },
          "404": { "description": "Not found" }
        }
      },
      "put": {
        "summary": "Update list",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "personId": { "type": "string", "format": "uuid" },
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "format": "uuid",
                          "description": "Omit for new items."
                        },
                        "title": { "type": "string" },
                        "url": { "type": "string", "format": "uri" },
                        "tags": {
                          "type": "array",
                          "items": { "type": "string" }
                        }
                      },
                      "required": ["title"]
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated list",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/List" }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete list",
        "responses": { "204": { "description": "Deleted" } }
      }
    },
    "/lists/{listId}/items/{itemId}": {
      "parameters": [
        {
          "name": "listId",
          "in": "path",
          "required": true,
          "schema": { "type": "string", "format": "uuid" }
        },
        {
          "name": "itemId",
          "in": "path",
          "required": true,
          "schema": { "type": "string", "format": "uuid" }
        }
      ],
      "delete": {
        "summary": "Remove an item from a list",
        "responses": { "204": { "description": "Item removed" } }
      }
    },
    "/lists/{listId}/items/{itemId}/tags": {
      "parameters": [
        {
          "name": "listId",
          "in": "path",
          "required": true,
          "schema": { "type": "string", "format": "uuid" }
        },
        {
          "name": "itemId",
          "in": "path",
          "required": true,
          "schema": { "type": "string", "format": "uuid" }
        }
      ],
      "post": {
        "summary": "Add a tag to a list item",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": { "tag": { "type": "string" } },
                "required": ["tag"]
              }
            }
          }
        },
        "responses": { "200": { "description": "Tag added" } }
      }
    },
    "/lists/{listId}/items/{itemId}/tags/{tagId}": {
      "parameters": [
        {
          "name": "listId",
          "in": "path",
          "required": true,
          "schema": { "type": "string", "format": "uuid" }
        },
        {
          "name": "itemId",
          "in": "path",
          "required": true,
          "schema": { "type": "string", "format": "uuid" }
        },
        {
          "name": "tagId",
          "in": "path",
          "required": true,
          "schema": { "type": "string", "format": "uuid" }
        }
      ],
      "delete": {
        "summary": "Remove a tag from a list item",
        "responses": { "204": { "description": "Tag removed" } }
      }
    },
    "/records": {
      "post": {
        "summary": "Add a gift record",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "personId": { "type": "string", "format": "uuid" },
                  "itemText": { "type": "string" },
                  "amount": { "type": "number", "minimum": 0 },
                  "date": { "type": "string", "format": "date-time" },
                  "tags": { "type": "array", "items": { "type": "string" } }
                },
                "required": ["personId", "itemText"]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Record created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GiftRecord" }
              }
            }
          }
        }
      },
      "get": {
        "summary": "Get all gift records for the authenticated user",
        "responses": {
          "200": {
            "description": "Records",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/GiftRecord" }
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete all gift records for the authenticated user",
        "responses": { "204": { "description": "All records deleted" } }
      }
    },
    "/records/search": {
      "get": {
        "summary": "Search gift records by item text",
        "parameters": [
          {
            "name": "itemText",
            "in": "query",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Matching records",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/GiftRecord" }
                }
              }
            }
          }
        }
      }
    },
    "/records/person/{personId}": {
      "parameters": [
        {
          "name": "personId",
          "in": "path",
          "required": true,
          "schema": { "type": "string", "format": "uuid" }
        }
      ],
      "get": {
        "summary": "Get all gift records for a specific person",
        "responses": {
          "200": {
            "description": "Records for the person",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/GiftRecord" }
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete all gift records for a specific person",
        "responses": { "204": { "description": "Records deleted" } }
      }
    },
    "/records/{id}": {

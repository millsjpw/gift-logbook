{
  "name": "server",
  "private": true,
  "scripts": {
    "build": "tsup",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest --config vitest.config.ts --run",
    "test:unit": "vitest --config vitest.unit.config.ts --run",
    "generate": "drizzle-kit generate",
    "migrate": "node dist/scripts/migrate.js",
    "migrate:dev": "drizzle-kit migrate",
    "verify-build": "test -f dist/index.js"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^3.2.4",
    "tsup": "^8.5.1",
    "tsx": "^4.0.0",
    "typescript": "^6.0.2",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "argon2": "^0.44.0",
    "cors": "^2.8.6",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "postgres": "^3.4.8"
  }
}

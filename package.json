{
  "name": "gift-logbook",
  "private": true,
  "version": "3.0.0",
  "workspaces": [
    "app",
    "server",
    "."
  ],
  "scripts": {
    "test": "npm --prefix server run test",
    "test:unit": "npm --prefix server run test:unit",
    "dev:server": "npm --prefix server run dev",
    "dev:app": "npm --prefix app run dev",
    "build:server": "npm --prefix server run build",
    "build:app": "npm --prefix app run build",
    "lint": "eslint .",
    "format:write": "prettier --write \"**/*.{js,ts,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{js,ts,json,css,md}\"",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.2.1",
    "globals": "^17.5.0",
    "prettier": "^3.8.3",
    "typescript-eslint": "^8.59.1"
  }
}
